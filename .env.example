# Copy this file to .env.local (npm run dev) and .env (docker compose) and fill
# in your own values. The real files are git-ignored; this template is not.
#
# Find both values in the Supabase dashboard: Project Settings > API.
# The anon key is designed to be public: it only works within Row Level
# Security. NEVER put the service_role key in this file or on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
