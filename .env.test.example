# Copy this file to .env.test and fill in the values. The real .env.test is
# git-ignored; this template is not. It is read by `npm run test:integration`.
#
# These point at a SEPARATE Supabase project used only for tests, never your
# real demo project, because the tests create and delete Users and data.
# Find all three in the Supabase dashboard: Project Settings > API.
# In CI the same three names are GitHub repository secrets.
SUPABASE_TEST_URL=https://your-test-project-ref.supabase.co
SUPABASE_TEST_ANON_KEY=your-test-project-anon-key

# SECRET. Used ONLY by the test code to create and delete throwaway test Users
# (it bypasses Row Level Security). It must NEVER be used in app code, put in
# .env.local, or added to Vercel. Keep it only here and in the GitHub secret.
SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-project-service-role-key
